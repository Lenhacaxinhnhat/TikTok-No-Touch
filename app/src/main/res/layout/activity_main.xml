<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:padding="24dp"
    android:background="#111111">

    <TextView
        android:id="@+id/tvTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="TikTok Gesture Control"
        android:textColor="#FFFFFF"
        android:textSize="22sp"
        android:textStyle="bold"
        android:layout_marginTop="40dp" />

    <TextView
        android:id="@+id/tvStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Trạng thái: chưa bật"
        android:textColor="#AAAAAA"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="24dp" />

    <Button
        android:id="@+id/btnGrantCamera"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="1. Cấp quyền Camera"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnOpenAccessibility"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="2. Mở cài đặt Accessibility"
        android:layout_marginBottom="12dp" />

    <Button
        android:id="@+id/btnToggleService"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="3. Bật nhận diện cử chỉ"
        android:layout_marginBottom="24dp" />

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:textColor="#888888"
        android:textSize="13sp"
        android:text="Cách dùng: Sau khi bật, mở TikTok lên và vẫy tay từ dưới lên trước camera trước để chuyển video kế tiếp, vẫy từ trên xuống để quay lại video trước." />

</LinearLayout>
